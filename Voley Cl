<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Voley CL</title>
  <style>
    body {
      margin: 0;
      background-color: #E6D6F6;
      font-family: 'Bernard MT Condensed', sans-serif;
    }

    header {
      position: relative;
      padding: 20px;
      text-align: center;
    }

    h1 {
      font-size: 48px;
      margin: 0;
    }

    .icon-button {
      position: absolute;
      top: 20px;
      padding: 10px 20px;
      border: none;
      background-color: #BA7AEA;
      color: white;
      font-family: 'Bernard MT Condensed', sans-serif;
      font-size: 16px;
      cursor: pointer;
      border-radius: 5px;
    }

    .home-button {
      right: 20px;
    }

    .menu-button {
      left: 20px;
    }

    .menu-panel {
      display: none;
      position: absolute;
      top: 60px;
      left: 20px;
      background-color: white;
      border: 1px solid #BA7AEA;
      border-radius: 10px;
      padding: 10px;
      z-index: 100;
    }

    .menu-panel button {
      display: block;
      width: 150px;
      margin: 5px 0;
      background-color: #E0B8F6;
      color: #4F4F4F;
      border: 2px solid #BA7AEA;
      font-size: 15px;
      font-family: 'Bernard MT Condensed', sans-serif;
      padding: 10px;
      cursor: pointer;
      border-radius: 5px;
    }

    .section-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 50px;
    }

    .section-buttons button {
      background-color: #E0B8F6;
      color: #4F4F4F;
      border: 2px solid #BA7AEA;
      font-size: 15px;
      font-family: 'Bernard MT Condensed', sans-serif;
      padding: 15px 30px;
      cursor: pointer;
      border-radius: 10px;
    }
  </style>
  <script>
    function toggleMenu() {
      const menu = document.getElementById('menuPanel');
      menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    function goTo(url) {
      window.location.href = url;
    }
  </script>
</head>
<body>

  <header>
    <!-- Botón de menú -->
    <button class="icon-button menu-button" onclick="toggleMenu()">☰ Menú</button>

    <!-- Menú desplegable -->
    <div id="menuPanel" class="menu-panel">
      <button onclick="goTo('que-es.html')">¿Qué es?</button>
      <button onclick="goTo('reglas.html')">Reglas</button>
      <button onclick="goTo('posiciones.html')">Posiciones</button>
      <button onclick="goTo('historia.html')">Historia</button>
      <button onclick="goTo('tipos.html')">Tipos</button>
    </div>

    <!-- Título -->
    <h1>Voley CL</h1>

    <!-- Botón de inicio -->
    <button class="icon-button home-button" onclick="goTo('index.html')">Inicio</button>
  </header>



  <div class="section-buttons">
    <button onclick="goTo('que-es.html')">¿Qué es?</button>
    <button onclick="goTo('reglas.html')">Reglas</button>
    <button onclick="goTo('posiciones.html')">Posiciones</button>
    <button onclick="goTo('historia.html')">Historia</button>
    <button onclick="goTo('tipos.html')">Tipos</button>
  </div>
</body>
</html>
